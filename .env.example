# aschenbrenner-unlimited — environment template. Copy to .env and fill secrets.
# Floor 2x / Ceiling UNLIMITED (v4): stocks + Tier-D LEAPS moonshot. NO crypto.
# Dedicated paper account (options level 3 required for LEAPS).

# ── Alpaca (dedicated "aschenbrenner unlimited" paper account) ───────────────
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # no trailing /v2
PAPER_MODE=true

# ── Paths ────────────────────────────────────────────────────────────────────
VAULT_PATH=/home/myrandy/gdrive/vault/aschenbrenner-unlimited
DAILY_ANALYSIS_PATH=/home/myrandy/gdrive/vault/daily_analysis
KILL_FILE=/home/myrandy/projects/aschenbrenner_unlimited/aschenbrenner-unlimited.HALT

# ── Scheduling ───────────────────────────────────────────────────────────────
TIMEZONE=America/Los_Angeles
CATCHUP_ON_START=true

# ── Thesis target ($40K → $80K floor in 3 years) ─────────────────────────────
TARGET_NAV_START=40000
TARGET_CAGR=0.26
TARGET_HORIZON_YEARS=3

# ── Rebalance rules (PDF §9). v4 uses a 15%→10% position cap. ─────────────────
CASH_BUFFER_PCT=0.05
POSITION_TRIM_TRIGGER_PCT=0.15
POSITION_TRIM_TARGET_PCT=0.10
CLUSTER_CAP_PCT=0.30
POSITION_STOP_PCT=0.35
DRAWDOWN_DEPLOY_PCT=0.15
DRAWDOWN_DEPLOY_SINGLE_PCT=0.25
REBALANCE_BAND_PCT=0.03
MAX_ORDERS_PER_DAY=10

# ── Phased build (PDF §11) ───────────────────────────────────────────────────
BUILD_DAILY_BUDGET=2000

# ── Tier-D micro-cap moonshot picks (config-pinned) ──────────────────────────
MICROCAP_1=IONQ   # quantum slot: IONQ / RGTI / QBTS
MICROCAP_2=ASTS   # defense-space slot: ASTS / RKLB / KTOS / MRCY

# ── Daily-analysis signal bias (re-orders equity choices only) ───────────────
SIGNAL_BIAS_ENABLED=true

# ── Real-money opt-in (out of scope; PA guard still applies) ─────────────────
LIVE_TRADING_ENABLED=false
LOG_LEVEL=info

# ── Telegram delivery (dedicated aschenbrenner_unlimited bot) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
